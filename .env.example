# ProofPath AI - Environment Configuration

# Client-Side Convex Deployment URL
VITE_CONVEX_URL=https://content-lemur-582.convex.cloud

# Server-Side Private Configuration (Set on Convex Dashboard or via `npx convex env set <KEY> <VALUE>`)
# Google Gemini API Key for Resume Analysis, Adaptive Challenges, and AI Career Assistant
# GEMINI_API_KEY=your_gemini_api_key_here

# Secret key required to authorize server-side initial administrator bootstrap
# ADMIN_BOOTSTRAP_KEY=your_secure_admin_bootstrap_key_here

# Optional Search API Key for Pluggable Live Web Discovery Adapter (e.g. SerpApi / Google Search API)
# JOB_SEARCH_API_KEY=your_search_api_key_here

